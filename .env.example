DATABASE_URL=postgres://ggt:ggt@localhost:5432/ggt
# Production : openssl rand -base64 32 (32 caractères minimum, valeur d'exemple refusée en production)
BETTER_AUTH_SECRET=change-me-with-openssl-rand-base64-32
BETTER_AUTH_URL=http://localhost:3000

# E-mails : smtp (obligatoire en production) | console | file (développement et tests uniquement)
EMAIL_MODE=console
# SMTP_URL=smtps://utilisateur:motdepasse@smtp.exemple.com:465
EMAIL_FROM="GGT <no-reply@exemple.com>"
# Vrai par défaut en production, faux en développement
# REQUIRE_EMAIL_VERIFICATION=true
# En-tête portant l'IP réelle derrière votre proxy (limitation de débit)
# TRUSTED_IP_HEADER=x-forwarded-for

# Dossier du stockage privé des justificatifs. En production : volume persistant ou stockage objet.
STORAGE_DIR=.storage
